{
  "name": "ClimaBot - 01 Cache Warming",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 30 }]
        }
      },
      "name": "Cada 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300],
      "id": "trigger-cache"
    },
    {
      "parameters": {
        "url": "={{$env.CLIMABOT_API_URL}}/api/internal/cache-update",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-internal-token", "value": "={{$env.CLIMABOT_INTERNAL_TOKEN}}" }
          ]
        },
        "options": { "timeout": 30000 },
        "method": "POST"
      },
      "name": "Warm All Caches",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "id": "http-cache-warm"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Check OK",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300],
      "id": "if-cache-ok"
    }
  ],
  "connections": {
    "Cada 30 min": { "main": [[{ "node": "Warm All Caches", "type": "main", "index": 0 }]] },
    "Warm All Caches": { "main": [[{ "node": "Check OK", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "climabot" }]
}

# === ClimaBot API — Variables de entorno ===

# Puerto del servidor
PORT=3500

# Modo
NODE_ENV=production

# CORS — dominio de la PWA
CORS_ORIGIN=https://clima.cancunbot.mx

# Cache TTL en segundos (15 min)
CACHE_TTL=900

# Token para endpoints admin (generar uno seguro con: openssl rand -hex 32)
ADMIN_TOKEN=cambia_esto_por_un_token_seguro

# Token para endpoints internos (n8n workflows)
INTERNAL_TOKEN=cambia_esto_por_otro_token_seguro

# Anthropic API Key — para generación de variantes Capa 2
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Modelo de Haiku para Capa 2
HAIKU_MODEL=claude-haiku-4-5-20251001

# Base de datos SQLite (path relativo al root del proyecto)
DB_PATH=./data/climabot.db
